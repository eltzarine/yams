rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /parties/{id} {
      // Une partie valide : uniquement ces champs, avec des tailles raisonnables
      // (« sheet » = la feuille de scores complète, facultative)
      function valide(d) {
        return d.keys().hasOnly(['date', 'winner', 'top', 'ranking', 'sheet', 'createdAt'])
          && d.date is string && d.date.size() <= 40
          && d.winner is string && d.winner.size() <= 40
          && d.top is int && d.top >= 0 && d.top <= 2000
          && d.ranking is list && d.ranking.size() >= 1 && d.ranking.size() <= 12
          && (!('sheet' in d) || (d.sheet is list && d.sheet.size() <= 12));
      }

      // Tout le monde peut voir l'historique
      allow read: if true;

      // Ajout : identifiant au bon format + date de création posée par le serveur
      allow create: if id.matches('^g[a-z0-9]{6,24}$')
        && valide(request.resource.data)
        && request.resource.data.createdAt == request.time;

      // Correction et suppression : seulement pendant 2 jours après la partie
      allow update: if valide(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.time < resource.data.createdAt + duration.value(2, 'd');
      allow delete: if request.time < resource.data.createdAt + duration.value(2, 'd');
    }
     // Partie en direct : lisible par tous, écrite par l'appli de l'hôte
    match /direct/{code} {
      function directValide(d) {
        return d.keys().hasOnly(['players', 'hote', 'scores', 'settings', 'started', 'last', 'updatedAt'])
          && (!('hote' in d) || d.hote == null || (d.hote is string && d.hote.size() <= 16))
          && d.players is list && d.players.size() >= 1 && d.players.size() <= 12
          && d.scores is map && d.scores.size() <= 12
          && d.settings is map
          && d.started is bool
          && (d.last == null || d.last is map)
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create, update: if code.matches('^[A-Z0-9]{4,8}$')
        && directValide(request.resource.data);
      allow delete: if true;

      // Joueurs qui rejoignent la partie depuis leur téléphone (lus par l'appli de l'hôte).
      // id = uid du compte, ou identifiant d'invité « g… » gardé sur le téléphone.
      match /joueurs/{jid} {
        function joueurValide(d) {
          return d.keys().hasOnly(['pseudo', 'compte', 'uid', 'at'])
            && d.pseudo is string && d.pseudo.size() >= 1 && d.pseudo.size() <= 30
            && d.compte is bool
            && d.at == request.time;
        }
        // compte : uniquement le sien, avec le pseudo validé par le mini-serveur
        function commeCompte(d) {
          return d.compte == true && request.auth != null
            && d.uid == request.auth.uid
            && d.pseudo == request.auth.token.pseudo;
        }
        // invité : nom sans « # » suivi de « #guest »
        function commeInvite(d) {
          return d.compte == false && !('uid' in d)
            && d.pseudo.matches('^[^#]{1,22}#guest$');
        }
        allow read: if true;
        allow create: if code.matches('^[A-Z0-9]{4,8}$')
          && joueurValide(request.resource.data)
          && ((commeCompte(request.resource.data) && jid == request.auth.uid)
              || (commeInvite(request.resource.data) && jid.matches('^g[a-z0-9]{16}$')));
        // un invité peut changer de nom, ou devenir son compte quand il se connecte
        allow update: if joueurValide(request.resource.data)
          && ((resource.data.compte == false && jid.matches('^g[a-z0-9]{16}$')
                && (commeInvite(request.resource.data) || commeCompte(request.resource.data)))
              || (resource.data.compte == true && commeCompte(request.resource.data)
                && resource.data.uid == request.auth.uid));
        allow delete: if false;
      }
    }
    // Invitation d'un joueur avec compte (« Déjà joué avec ») : document = uid de l'invité.
    // L'hôte (connecté) l'écrit à son nom ; l'invité la lit, la refuse ou la supprime.
    match /invitations/{uid} {
      function invValide(d) {
        return d.keys().hasOnly(['code', 'hote', 'hoteUid', 'at'])
          && d.code is string && d.code.matches('^[A-Z0-9]{4,8}$')
          && d.hoteUid == request.auth.uid
          && d.hote == request.auth.token.pseudo
          && d.at == request.time;
      }
      allow read: if request.auth != null
        && (request.auth.uid == uid || resource == null || resource.data.hoteUid == request.auth.uid);
      allow create: if request.auth != null && request.auth.uid != uid && invValide(request.resource.data);
      allow update: if request.auth != null && (
        (request.auth.uid != uid && invValide(request.resource.data))
        || (request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['refus'])
            && request.resource.data.refus == true));
      allow delete: if request.auth != null
        && (request.auth.uid == uid || resource.data.hoteUid == request.auth.uid);
    }
    // Profil public d'un joueur (pseudo seulement) : chacun ne modifie que le sien,
    // et le pseudo doit être celui validé par le mini-serveur (unicité)
    match /joueurs/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pseudo', 'updatedAt'])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo == request.auth.token.pseudo
        && request.resource.data.updatedAt == request.time;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    // Tout le reste de la base est fermé
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
